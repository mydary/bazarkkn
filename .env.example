DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# NEXTAUTH_SECRET bisa digenerate lewat: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-string-acak-yang-panjang"
NEXTAUTH_URL="http://localhost:3000"

# Dari dashboard pusher.com (gratis untuk skala kecil) -- dipakai untuk update
# status pesanan real-time ke pembeli & dashboard panitia.
PUSHER_APP_ID="xxxxxx"
PUSHER_KEY="xxxxxxxxxxxxxxxxxxxx"
PUSHER_SECRET="xxxxxxxxxxxxxxxxxxxx"
PUSHER_CLUSTER="ap1"
NEXT_PUBLIC_PUSHER_KEY="xxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# Dipakai scripts/print-entry-qr.js untuk menyusun URL QR masuk bazar
APP_URL="https://bazar.contohkkn.my.id"
