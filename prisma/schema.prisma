generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Kelompok {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  qrisImageUrl    String?    // disimpan sebagai data URL (base64) hasil upload panitia
  whatsappNumber  String?    // format 62xxxxxxxxxx, dipakai untuk link wa.me
  categories      Category[]
  products        Product[]
  orderGroups     OrderGroup[]
  staff           StaffUser[]
  createdAt       DateTime   @default(now())
}

model Category {
  id          String     @id @default(cuid())
  kelompok    Kelompok   @relation(fields: [kelompokId], references: [id])
  kelompokId  String
  name        String
  sortOrder   Int        @default(0)
  products    Product[]
}

model Product {
  id          String      @id @default(cuid())
  kelompok    Kelompok    @relation(fields: [kelompokId], references: [id])
  kelompokId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  String
  name        String
  description String?
  price       Int
  imageUrl    String?
  isAvailable Boolean     @default(true)
  orderItems  OrderItem[]
}

enum DeliveryMethod {
  PICKUP   // ambil sendiri di tenda kelompok
  DELIVER  // "Antar ke sini"
}

// Satu Order = satu kunjungan checkout pembeli, bisa berisi produk dari
// beberapa kelompok sekaligus. Tiap kelompok yang terlibat punya
// OrderGroup sendiri (QRIS, status bayar, barcode ambil masing-masing).
model Order {
  id               String         @id @default(cuid())
  buyerName        String
  buyerContact     String         // nomor WA pembeli
  deliveryMethod   DeliveryMethod
  deliveryLocation String?        // wajib diisi kalau DELIVER (lokasi/nomor tenda pembeli)
  groups           OrderGroup[]
  createdAt        DateTime       @default(now())
}

enum OrderGroupStatus {
  AWAITING_CLAIM       // menunggu pembeli klik "saya sudah bayar" utk kelompok ini
  WAITING_VERIFICATION // pembeli sudah klaim bayar, menunggu konfirmasi panitia
  VERIFIED             // panitia sudah konfirmasi, barcode ambil aktif
  COMPLETED            // sudah diambil / diantar
  REJECTED             // panitia menolak klaim (mis. tidak ada bukti transfer masuk)
}

model OrderGroup {
  id           String            @id @default(cuid())
  order        Order             @relation(fields: [orderId], references: [id])
  orderId      String
  kelompok     Kelompok          @relation(fields: [kelompokId], references: [id])
  kelompokId   String
  subtotal     Int
  status       OrderGroupStatus  @default(AWAITING_CLAIM)
  pickupToken  String            @unique @default(cuid())
  items        OrderItem[]
  claimedAt    DateTime?
  verifiedAt   DateTime?
  completedAt  DateTime?
  proofImageUrl String?         // screenshot bukti pembayaran
  createdAt    DateTime          @default(now())
}

model OrderItem {
  id            String     @id @default(cuid())
  orderGroup    OrderGroup @relation(fields: [orderGroupId], references: [id])
  orderGroupId  String
  product       Product    @relation(fields: [productId], references: [id])
  productId     String
  qty           Int
  priceAtOrder  Int
  notes         String?
}

model StaffUser {
  id           String   @id @default(cuid())
  kelompok     Kelompok? @relation(fields: [kelompokId], references: [id])
  kelompokId   String?
  name         String
  username     String   @unique
  passwordHash String
  role         String   @default("STAFF") // STAFF | SUPERADMIN
}

model BazarSetting {
  id        String   @id @default("singleton")
  isOpen    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
